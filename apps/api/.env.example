# Copie para apps/api/.env. Variáveis validadas em src/config/env.schema.ts:
# a API não sobe com configuração ausente ou inválida.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://mira:SENHA@localhost:5432/mira_salgados
CORS_ORIGINS=http://localhost:4200
TRUST_PROXY=0

# Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# Navegadores aceitam cookie Secure em http://localhost; em produção é obrigatório.
COOKIE_SECURE=true

# Notificações e worker isolado (opcional; padrão SIMULADO sem envio externo).
# NOTIFICACOES_MODO=SIMULADO
# NOTIFICACOES_WORKER_INTERVALO_MS=5000
# NOTIFICACOES_WEBHOOK_HOST=127.0.0.1
# NOTIFICACOES_WEBHOOK_PORT=0
# NOTIFICACOES_WEBHOOK_SECRET=
# Conector GoWA (obrigatórios apenas quando NOTIFICACOES_MODO=GOWA):
# NOTIFICACOES_CONECTOR_URL=http://gowa:3000
# NOTIFICACOES_CONECTOR_TOKEN=usuario:senha
# NOTIFICACOES_CONECTOR_DEVICE_ID=
