# Copie para apps/api/.env. Variáveis validadas em src/config/env.schema.ts:
# a API não sobe com configuração ausente ou inválida.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://mira:SENHA@localhost:5432/mira_salgados
CORS_ORIGINS=http://localhost:4200
TRUST_PROXY=0

# Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# Navegadores aceitam cookie Secure em http://localhost; em produção é obrigatório.
COOKIE_SECURE=true
