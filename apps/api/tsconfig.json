{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2024",
    "lib": ["ES2024"],
    "esModuleInterop": true,
    "resolvePackageJsonExports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "removeComments": true,
    "sourceMap": true,
    "incremental": true,
    "outDir": "./dist",
    "rootDir": ".",
    // Entidades e DTOs são hidratados pelo TypeORM e pelo class-transformer, não por construtor.
    "strictPropertyInitialization": false,
    "types": ["node"]
  },
  "include": ["src", "test", "vitest.config.ts", "vitest.config.integration.ts"]
}
