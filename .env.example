# Copie para .env e ajuste. O arquivo .env nunca vai para o repositório.
# Use senhas só com letras e números (ex.: openssl rand -hex 24): elas entram na
# URL de conexão do banco sem precisar de escape.

# Banco
POSTGRES_DB=mira_salgados
POSTGRES_TEST_DB=mira_salgados_test
POSTGRES_USER=mira
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# API e web (pilha completa com docker compose)
# Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=
WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080
LOG_LEVEL=info

# Proxies à frente da API: 1 com só o nginx da pilha; 2 quando um proxy HTTPS
# (Caddy ou Cloudflare Tunnel) fica à frente do nginx. Errar este número faz
# todos os acessos parecerem vir do mesmo IP e divide o limite de login entre todos.
TRUST_PROXY=1

# Produção com HTTPS (veja docs/producao.md). Endereço público, com https://:
# WEB_ORIGIN=https://mirasalgados.com.br
# Com Caddy (docker-compose.https.yml): domínio sem https://
# DOMINIO=mirasalgados.com.br
# Com Cloudflare Tunnel (docker-compose.tunel.yml): token do túnel
# CLOUDFLARE_TUNNEL_TOKEN=
